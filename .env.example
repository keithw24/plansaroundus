# Copy to .env. Blank values count as unset. Only apps/ read these.
NODE_ENV=development
LOG_LEVEL=info
PORT=8787
# Wait this long for follow-up messages before answering.
INBOX_BATCH_MS=2000

# terminal (dev loop) or photon (iMessage). photon also needs DATABASE_URL.
CHAT_PROVIDER=terminal
PHOTON_PROJECT_ID=
PHOTON_API_KEY=

# Optional: each one missing switches off something specific.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GOOGLE_MAPS_API_KEY=
DATABASE_URL=
# Required with DATABASE_URL, 32+ chars (openssl rand -hex 32). Changing it forgets all chat memory.
CHAT_KEY_SECRET=
RESEND_API_KEY=
RESEND_FROM=
SITE_AUTH_SECRET=
SITE_ORIGINS=

# Feature flags (see packages/core/src/flags.ts). Unknown names fail startup.
FLAGS_ON=
FLAGS_OFF=
FLAGS_BETA=
FLAGS_BETA_PHONES=
