{
  "name": "around-us",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/skills/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check .",
    "check": "npm run typecheck && npm run lint && npm test",
    "migrate": "npm run migrate -w @aroundus/pg"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
